{
  "name": "nexprop",
  "version": "1.0.0",
  "description": "Nexprop Application",
  "scripts": {
    "start:client": "cd client && npm run start",
    "start:android": "cd client && npm run android",
    "start:mirror": "scrcpy",
    "start:server": "cd server && npm run dev",
    
    "build:android:debug": "cd client/android && ./gradlew assembleDebug",
    "build:android:release": "cd client/android && ./gradlew assembleRelease",
    
    "install:client": "cd client && npm i",
    "install:server": "cd server && npm i",
    "install:apk:debug": "cd client && npm run apk:debug",
    "install:apk:release": "cd client && npm run apk:release",

    "contract:compile": "cd contract && npm run recompile",
    "contract:abi": "cd contract && npm run abi:generate && npm run error:collect",
    "contract:deploy": "cd contract && npm run deploy",
    "blockchain:testnode": "cd contract && npm run node"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
