{
  "name": "contract",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "node": "npx hardhat node --hostname 0.0.0.0",
    "error:collect": "node scripts/collect-errors.js",
    "clean": "npx hardhat clean",
    "compile": "npx hardhat compile",
    "recompile": "npx hardhat clean && hardhat compile",
    "abi:generate": "node scripts/generate-abi.js",
    "deploy": "npx hardhat run scripts/deploy.js --network localhost --show-stack-traces"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.14",
    "@types/node": "^22.20.0",
    "hardhat": "^3.9.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
