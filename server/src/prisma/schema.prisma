generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id         String   @id @default(cuid())
  address    String   @unique
  walletName String
  name       String
  createdAt  DateTime @default(now())
  nonce      String   @default(dbgenerated())
}
