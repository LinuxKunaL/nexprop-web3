generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int       @id @default(autoincrement())
  address    String    @unique
  walletName String
  name       String?
  createdAt  DateTime  @default(now())
  nonce      String?
  business   Business?
}

model Business {
  id              Int    @id @default(autoincrement())
  businessName    String
  businessType    String
  businessAddress String
  userId          Int    @unique
  user            User   @relation(fields: [userId], references: [id])
}
