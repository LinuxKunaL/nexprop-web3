generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int       @id @default(autoincrement())
  address    String    @unique
  walletName String
  name       String?
  createdAt  DateTime  @default(now())
  nonce      String?
  business   Business?
}

model Business {
  id              Int    @id @default(autoincrement())
  businessName    String
  businessType    String
  businessAddress String
  userId          Int    @unique
  user            User   @relation(fields: [userId], references: [id])

  properties Property[]
}

model Metadata {
  id          Int    @id @default(autoincrement())
  title       String
  category    String
  type        String
  description String
  image       String
}

model Property {
  id         Int      @id @default(autoincrement())
  propertyId Int      @unique
  thumbnail  String
  price      Int
  businessId Int
  addressId  Int
  address    Address  @relation(fields: [addressId], references: [id])
  business   Business @relation(fields: [businessId], references: [id])
}

model Address {
  id          Int        @id @default(autoincrement())
  country     String
  states      String
  zipCode     Int
  addressLine String
  latitude    Float
  longitude   Float
  properties  Property[]
}
