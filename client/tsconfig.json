{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "paths": {
      "@ui/*": ["./src/components/ui/*"],
      "@components/*": ["./src/components/*"],
      "@utils/*": ["./src/utils/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@assets/*": ["./src/assets/*"],
      "@providers/*": ["./src/providers/*"],
      "@screen/*": ["./src/app/*"],
      "@constants/*": ["./src/constants/*"],
      "@types_/*": ["./src/types/*"],
      "@context/*": ["./src/context/*"],
      "@data/*": ["./src/data/*"],
      "@features/*": ["./src/features/*"],
      "@stores/*": ["./src/stores/*"],
      "@services/*": ["./src/services/*"],
      "@abi/*": ["./src/abi/*"],
      "@config": ["./src/config.ts"],
      "@api/*": ["./src/api/*"],
      "@wallet": ["./src/wallet"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "env.d.ts"
  ]
}
